{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kcc-trader",
  "compatibility_date": "2026-11-04",
  "main": "./src/index.ts",
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/sync",
      "/u/*"
    ]
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "kcc.atrx.dev",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CARDS",
      "id": "8b7acc55a98e46faa665f4b07b35b619"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kcc-trader",
      "database_id": "a18ed638-73ba-4beb-a1e5-703bdfeab28b",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}